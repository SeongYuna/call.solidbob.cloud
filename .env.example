# CallGuard 환경변수 템플릿
#
# 이 파일은 "키 이름만" 공유하기 위한 템플릿입니다. 실제 값은 절대 여기에 적지
# 마십시오. 복사해서 쓰십시오:
#
#   cp .env.example .env
#
# .env / .env.local 은 .gitignore 에 등록되어 커밋되지 않습니다.
# 이 파일(.env.example)만 커밋합니다.

# --- Google Cloud Speech-to-Text (A-1, A-2) ---------------------------------
# GCP 콘솔 > IAM 및 관리자 > 서비스 계정에서 발급한 JSON 키 파일의 "경로".
# 키 값 자체를 여기 붙여넣지 말고, 파일 경로만 지정합니다.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# --- STT 사용량 가드 (COST-1) ------------------------------------------------
# 무료 크레딧/무료 한도를 넘지 않도록 애플리케이션 레벨에서 거는 2차 안전장치.
# GCP 콘솔의 쿼터 제한(1차, 실제 하드캡)·예산 알림(통지용)과는 별개다.
# services/call-mediator는 누적 사용 시간이 이 값을 넘으면 새 STT 스트림 오픈을 거부하고
# 로그를 남긴다. 값을 비워두면 가드가 비활성화되므로 반드시 채운다.
STT_MAX_SECONDS_PER_DAY=
STT_MAX_SECONDS_PER_MONTH=

# --- PostgreSQL (2026-08-27 MySQL 에서 전환 — decisions/018) -------------------------------------------------------------------
# call / transcript / recommendation / closure / eval_result 테이블을 둔다.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB_NAME=
POSTGRES_USER=

# 비밀번호. 값을 넣는 순간 이 파일이 아니라 .env 에 있어야 한다.
POSTGRES_PASSWORD=

# 위 값들을 조합한 URL. 드라이버가 URL만 받는 경우 사용한다.
# 형식: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# --- Elasticsearch (nori + dense_vector 하이브리드 검색, B-2) ----------------
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# --- CORS (apps/call 가 브라우저에서 코어 API 를 부른다) -----------------
# 허용할 origin 을 쉼표로 나열한다. 비워 두면 로컬 Vite(http://localhost:5173, http://127.0.0.1:5173)만 허용.
# 운영에서는 대시보드가 서빙되는 origin 을 배포 env 에 넣는다 — 같은 origin 에서 내주면 필요 없다.
CORS_ALLOWED_ORIGINS=

# --- AWS (infra 배포용) -------------------------------------------------------
# 예: ap-northeast-2
AWS_REGION=

# 로컬 개발에서 IAM 사용자 자격증명이 필요한 경우에만 사용한다.
# EC2/ECS 에서 실행할 때는 비워 두고 IAM 역할을 붙인다 — 장기 키를 파일에 두지 않는
# 편이 안전하다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 테스트 음성 보관 (A-6, 2026-09-14 `_project/decisions/110`) -----------------
# 팀원이 브라우저에서 테스트 음성을 올리고 나중에 다시 듣는다.
# 브라우저는 AWS 자격증명을 들지 않는다 — server 가 presigned POST 를 발급한다.
#
# ⚠ 운영에서는 위 AWS_ACCESS_KEY_ID/SECRET 을 넣지 않는다. boto3 기본 자격증명 체인이
#   EC2 인스턴스 역할(callguard-ec2-role)을 IMDSv2 로 가져온다 (2026-09-14 운영 파드 확인).
#
# S3_BUCKET 과 UPLOAD_TOKEN 이 **둘 다** 있어야 켜진다. 하나만 있으면 안 꽂히고
#   토큰만 없으면 503, 버킷만 없으면 501 로 남는다 — 두 오류가 원인을 구분해 준다.
S3_BUCKET=

# 업로드 문을 여는 비밀. 비워 두면 문이 **잠긴다**(fail-closed) — 열리는 게 아니다.
# 만들기: openssl rand -hex 16.  팀원에게 나눠 주는 값이라 저장소에 넣지 않는다(SEC-2).
UPLOAD_TOKEN=

# 한 파일 상한(바이트). 비우면 100MB. S3 정책 content-length-range 로도 함께 나가
# 브라우저가 거짓 크기를 보내도 S3 가 실제 바이트로 거절한다.
UPLOAD_MAX_BYTES=

# --- 쓰기 경로 서비스 토큰 (2026-09-20, _project/decisions/120) ---
# 콜 미디에이터 → 서버의 쓰기 일곱 경로(POST /hub/calls·/transcripts·/recommendations …)를 잠근다.
# ⚠ 비우면 **열린다**(UPLOAD_TOKEN 과 반대 — 이행기). /health 의 ingest_guard 가 open/locked 로 말한다.
# 아래 CORE_API_TOKEN 과 **같은 값**이어야 한다. 만들기: openssl rand -hex 32
INGEST_SERVICE_TOKEN=

# --- 모델 스포크 — 전부 선택. **비우면 지금 운영과 같다**(규칙 마스킹 · BM25 · 스니펫 카드) ---
# server/core/config.py 가 읽는 키인데 이 파일에 없었다(2026-09-15 부터 미결). 값은 디렉터리·모델 이름이지 비밀이 아니다.
# 서버 이미지에 torch·모델이 없으면 값을 넣어도 조용히 기본 동작으로 내려간다 — 켜졌는지는 /health 의 spokes 로 본다.
# C-5 P6·P7 NER (ai/apps/pii_ner). scripts/download_models.py → models/koelectra-ner
PII_NER_MODEL_DIR=
# B-2·B-3 임베딩·리랭킹 검색(decisions/206). 임베딩(models/koe5)이 있어야 켜지고 리랭커(models/bge-reranker-v2-m3)는 선택
RETRIEVAL_EMBED_MODEL_DIR=
RETRIEVAL_RERANK_MODEL_DIR=
# B-4 서류 목록 카드 생성(decisions/207). **둘 다 있어야** 켜진다 — OLLAMA_URL 만으로는 안 켜진다(추천 지연이 조용히 느는 것을 막는다)
OLLAMA_URL=
GENERATION_MODEL=

# --- 고객 식별 (2026-09-14, `_project/decisions/304`) ---------------------------
# 발신 번호를 HMAC-SHA256 으로 바꿔 customer_id 를 만드는 서버 비밀키 (담당: 장민석).
# 없으면 통화는 그대로 열리고 고객 연결만 하지 않는다 — 평문 번호를 대신 저장하지 않는다.
# ⚠ 바꾸거나 잃으면 기존 customer_id·블랙리스트 등록을 다시 찾을 수 없다.
CUSTOMER_REF_HMAC_KEY=

# --- HuggingFace ---------------------------------------------------------------
# gated 모델을 쓰지 않는 한 비워 둬도 된다 (임베딩·KcELECTRA·카드 요약 모델은 대부분 공개 모델).
HUGGINGFACE_TOKEN=

# --- 관리자 로그인 (구글, apps/admin, 2026-09-14) -----------------------------
# 회원가입 화면은 없다. 구글 인증을 통과해도 admin_account 테이블에 이메일이
# 없으면 403 이다 — 행 추가·삭제(관리자 등록·해제)는 운영자가 직접 SQL로 한다.

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 만든 OAuth 클라이언트 ID.
# 프론트(Google Identity Services)와 백엔드(id_token audience 검증) 양쪽에 같은 값을 쓴다.
GOOGLE_OAUTH_CLIENT_ID=

# JWT(access token) 서명 비밀키. 32바이트 이상 무작위 문자열을 쓴다 — 예: `openssl rand -hex 32`.
ADMIN_JWT_SECRET=

# 테스트 스코프로 짧게 잡은 값(초 단위). access는 Redis 세션 TTL과 같은 값이어야 한다.
ADMIN_ACCESS_TOKEN_TTL_SECONDS=300
ADMIN_REFRESH_TOKEN_TTL_SECONDS=600

# --- Redis (관리자 access token 세션 전용, 테스트 스코프) ---------------------
# 로컬: `docker run -d --name callguard-redis -p 127.0.0.1:6379:6379 redis:7-alpine`
# ElastiCache(관리형 Redis)는 만들지 않는다 — infra/CLAUDE.md §1-2.
REDIS_URL=

# --- 콜 미디에이터 (services/call-mediator — A-1~A-4, 2026-09-11) ----------------------------
# 오디오 중계 + Google STT 스트리밍 + server 전달. 위의 GOOGLE_APPLICATION_CREDENTIALS ·
# STT_MAX_SECONDS_PER_DAY/_MONTH · CORS_ALLOWED_ORIGINS 도 콜 미디에이터가 함께 읽는다.
# 읽는 곳은 services/call-mediator/src/config.ts 하나뿐이다.

# 콜 미디에이터가 듣는 포트. 비워 두면 8080.
CALL_MEDIATOR_PORT=

# server(FastAPI) 주소. 비워 두면 http://localhost:8000 — 운영(k3s)은 http://callguard-server
CORE_API_URL=
# 서버 쓰기 경로의 서비스 토큰 — 위 INGEST_SERVICE_TOKEN 과 같은 값. 비우면 Authorization 헤더를 보내지 않는다.
# ⚠ 운영에서는 **미디에이터 쪽에 먼저 넣고** 서버 쪽에 넣는다. 거꾸로 하면 서버 호출이 전부 401 이다(decisions/120).
CORE_API_TOKEN=

# 접속 토큰 둘. 비워 두면 이 머신(루프백) 접속만 받는다 — 밖에서 오는 요청은 전부 401(fail-closed).
# 둘은 서로 다른 값이어야 한다(같으면 기동 때 경고). 운영은 release.yml 이 k8s 시크릿 call-mediator-tokens 를
# 인스턴스 안에서 무작위로 만든다 — 여기에 운영 값을 적지 않는다.
# /ingest(오디오 → STT, 과금) 토큰. 진짜 비밀 — 오디오 생산자만 갖고, 헤더로만 보낸다.
CALL_MEDIATOR_INGEST_TOKEN=
# /ws(자막 보기) 토큰. 대시보드(브라우저)가 내므로 비밀이 아니다 — 무작위 스캔만 막는다.
CALL_MEDIATOR_VIEW_TOKEN=

# --- Google Cloud Text-to-Speech — 합성 통화 재생기 소리 (2026-09-18) --------------------
# `services/call-mediator/scripts/replay_persona_call.ts --speak google` 과 `--prefetch` 만 읽는다.
# ⚠ 운영(k8s 시크릿 server-env · call-mediator-tokens)에는 넣지 않는다 — 시연 머신 전용이다.
#   서버·콜 미디에이터 본체는 이 키를 읽지 않는다(TTS 는 재생기 프로세스에서만 돈다).
# 발급: Google Cloud Console > API 및 서비스 > 라이브러리 > "Cloud Text-to-Speech API" 사용 설정
#      > 사용자 인증 정보 > 사용자 인증 정보 만들기 > API 키 > 키 제한: "API 제한 → Cloud Text-to-Speech API 하나만".
#   위 GOOGLE_APPLICATION_CREDENTIALS(서비스 계정 파일)와 다른 종류다 — 문자열 키다. 절차·비용: scripts/persona_sim/TTS.md
GOOGLE_TTS_API_KEY=

# 월 청구 문자 수 상한(2차 가드, COST-1 과 같은 구조 — 1차는 콘솔 할당량). 호출 전에 장부(data/processed/tts-usage.json)와
# 비교해 넘기면 부르지 않는다. 비우면 900000. 공식 무료 한도는 WaveNet+Standard 합산 400만 자/월(2026-09-18 가격표)이지만
# 같은 프로젝트의 다른 사용을 모르니 그 아래 둔다. 0 은 전부 막음. SSML 태그·공백까지 문자로 센다.
GOOGLE_TTS_MAX_CHARS_PER_MONTH=
