# CallGuard 환경변수 템플릿
#
# 이 파일은 "키 이름만" 공유하기 위한 템플릿입니다. 실제 값은 절대 여기에 적지
# 마십시오. 복사해서 쓰십시오:
#
#   cp .env.example .env
#
# .env / .env.local 은 .gitignore 에 등록되어 커밋되지 않습니다.
# 이 파일(.env.example)만 커밋합니다.

# --- Google Cloud Speech-to-Text (A-1, A-2) ---------------------------------
# GCP 콘솔 > IAM 및 관리자 > 서비스 계정에서 발급한 JSON 키 파일의 "경로".
# 키 값 자체를 여기 붙여넣지 말고, 파일 경로만 지정합니다.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# --- STT 사용량 가드 (COST-1) ------------------------------------------------
# 무료 크레딧/무료 한도를 넘지 않도록 애플리케이션 레벨에서 거는 2차 안전장치.
# GCP 콘솔의 쿼터 제한(1차, 실제 하드캡)·예산 알림(통지용)과는 별개다.
# services/gateway는 누적 사용 시간이 이 값을 넘으면 새 STT 스트림 오픈을 거부하고
# 로그를 남긴다. 값을 비워두면 가드가 비활성화되므로 반드시 채운다.
STT_MAX_SECONDS_PER_DAY=
STT_MAX_SECONDS_PER_MONTH=

# --- PostgreSQL (2026-08-27 MySQL 에서 전환 — decisions/018) -------------------------------------------------------------------
# call / transcript / recommendation / closure / eval_result 테이블을 둔다.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB_NAME=
POSTGRES_USER=

# 비밀번호. 값을 넣는 순간 이 파일이 아니라 .env 에 있어야 한다.
POSTGRES_PASSWORD=

# 위 값들을 조합한 URL. 드라이버가 URL만 받는 경우 사용한다.
# 형식: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# --- Elasticsearch (nori + dense_vector 하이브리드 검색, B-2) ----------------
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# --- CORS (apps/call 가 브라우저에서 코어 API 를 부른다) -----------------
# 허용할 origin 을 쉼표로 나열한다. 비워 두면 로컬 Vite(http://localhost:5173, http://127.0.0.1:5173)만 허용.
# 운영에서는 대시보드가 서빙되는 origin 을 배포 env 에 넣는다 — 같은 origin 에서 내주면 필요 없다.
CORS_ALLOWED_ORIGINS=

# --- AWS (infra 배포용) -------------------------------------------------------
# 예: ap-northeast-2
AWS_REGION=

# 로컬 개발에서 IAM 사용자 자격증명이 필요한 경우에만 사용한다.
# EC2/ECS 에서 실행할 때는 비워 두고 IAM 역할을 붙인다 — 장기 키를 파일에 두지 않는
# 편이 안전하다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- HuggingFace ---------------------------------------------------------------
# gated 모델을 쓰지 않는 한 비워 둬도 된다 (임베딩·KcELECTRA·카드 요약 모델은 대부분 공개 모델).
HUGGINGFACE_TOKEN=

# --- 관리자 로그인 (구글, apps/admin, 2026-09-14) -----------------------------
# 회원가입 화면은 없다. 구글 인증을 통과해도 admin_account 테이블에 이메일이
# 없으면 403 이다 — 행 추가·삭제(관리자 등록·해제)는 운영자가 직접 SQL로 한다.

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 만든 OAuth 클라이언트 ID.
# 프론트(Google Identity Services)와 백엔드(id_token audience 검증) 양쪽에 같은 값을 쓴다.
GOOGLE_OAUTH_CLIENT_ID=

# JWT(access token) 서명 비밀키. 32바이트 이상 무작위 문자열을 쓴다 — 예: `openssl rand -hex 32`.
ADMIN_JWT_SECRET=

# 테스트 스코프로 짧게 잡은 값(초 단위). access는 Redis 세션 TTL과 같은 값이어야 한다.
ADMIN_ACCESS_TOKEN_TTL_SECONDS=300
ADMIN_REFRESH_TOKEN_TTL_SECONDS=600

# --- Redis (관리자 access token 세션 전용, 테스트 스코프) ---------------------
# 로컬: `docker run -d --name callguard-redis -p 127.0.0.1:6379:6379 redis:7-alpine`
# ElastiCache(관리형 Redis)는 만들지 않는다 — infra/CLAUDE.md §1-2.
REDIS_URL=
