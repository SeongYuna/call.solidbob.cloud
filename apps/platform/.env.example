# CallGuard 홍보 페이지(apps/platform) 환경변수 템플릿.
# 복사해서 쓴다: cp .env.example .env.local  (.env.local 은 .gitignore 대상)

# 히어로의 "통화 받기" 데모(LiveCallModal)가 붙는 게이트웨이 주소.
# 로컬: ws://localhost:8080  ·  운영: wss://server.solidbob.cloud/gateway
# 실제로 연결되려면 팀 전용 링크(?call_token=<GATEWAY_INGEST_TOKEN>)로 방문해야 한다 —
# 일반 방문자는 이 값이 있어도 토큰이 없어 연결되지 않는다.
VITE_GATEWAY_WS_URL=
