# 비워두면 mock 콜 미디에이터가 7.3절 v2 예시 시나리오를 재생한다.
# 실제 services/call-mediator 가 생기면 WebSocket URL 을 넣는다.
VITE_CALL_MEDIATOR_WS_URL=

# FastAPI REST (선택). 없으면 코어 클라이언트는 호출하지 않는다(mock 유지).
# 값이 있으면 GET /hub/calls·/hub/calls/{id}/transcript, POST /hub/search·
# /hub/blacklist-requests·/hub/cards/{id}/feedback 을 실제로 부른다
# (`lib/api/coreClient.ts`, `w4-dashboard-live-contract`). ngrok으로 열면
# ngrok-skip-browser-warning 헤더를 자동으로 붙인다 — 값 설정은 필요 없다.
VITE_CORE_API_URL=

# "고객과 전화하기" 마이크 데모(AgentCallBox, 팀 전용)가 붙는 콜 미디에이터 기본
# 주소 — 여기에 /dev/text 를 붙여 연결한다. 위 VITE_CALL_MEDIATOR_WS_URL(대시보드
# 실시간 수신용, /ws 경로 포함)과는 다른 값이니 혼동하지 않는다.
# 로컬: ws://localhost:8080  ·  운영: wss://server.solidbob.cloud/call-mediator
# 실제로 연결되려면 팀 전용 링크(?call_token=<CALL_MEDIATOR_INGEST_TOKEN>)로 방문해야 한다.
VITE_CALL_MEDIATOR_DEMO_BASE_URL=
