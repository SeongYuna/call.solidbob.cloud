# 비워두면 mock 게이트웨이가 7.3절 v2 예시 시나리오를 재생한다.
# 실제 services/gateway 가 생기면 WebSocket URL 을 넣는다.
VITE_GATEWAY_WS_URL=

# FastAPI REST (선택). 없으면 코어 클라이언트는 호출하지 않는다.
VITE_CORE_API_URL=

# "고객과 전화하기" 마이크 데모(AgentCallBox, 팀 전용)가 붙는 게이트웨이 기본
# 주소 — 여기에 /dev/text 를 붙여 연결한다. 위 VITE_GATEWAY_WS_URL(대시보드
# 실시간 수신용, /ws 경로 포함)과는 다른 값이니 혼동하지 않는다.
# 로컬: ws://localhost:8080  ·  운영: wss://server.solidbob.cloud/gateway
# 실제로 연결되려면 팀 전용 링크(?call_token=<GATEWAY_INGEST_TOKEN>)로 방문해야 한다.
VITE_GATEWAY_DEMO_BASE_URL=
