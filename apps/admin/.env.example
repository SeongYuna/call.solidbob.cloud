# CallGuard 관리자 화면(apps/admin) 환경변수 템플릿.
# 복사해서 쓴다: cp .env.example .env.local  (.env.local 은 .gitignore 대상)

# server(FastAPI) 코어 주소. 로컬은 uvicorn 기본값, 운영은 배포 도메인.
VITE_API_BASE_URL=http://localhost:8000

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보의 OAuth 클라이언트 ID.
# server/.env 의 GOOGLE_OAUTH_CLIENT_ID 와 같은 값이어야 한다(양쪽이 같은 audience 를 본다).
VITE_GOOGLE_OAUTH_CLIENT_ID=
