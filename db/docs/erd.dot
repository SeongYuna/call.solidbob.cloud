digraph CallGuardERD {
  rankdir=LR;
  graph [fontname="Helvetica", nodesep=0.7, ranksep=1.3, splines=polyline];
  node [fontname="Helvetica", shape=plain];
  edge [fontname="Helvetica", fontsize=11, arrowtail=tee, arrowhead=crow, dir=both, color="#555555"];

  subgraph "cluster_고객" {
    label="고객"; style=rounded; color="#cccccc"; fontname="Helvetica"; fontsize=13;
    "customer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>customer</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>customer_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">first_seen_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR></TABLE>>];
    "agent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>agent</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>agent_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">team</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('agent','admin')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">hired_on</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATE</FONT></TD></TR></TABLE>>];
  }

  subgraph "cluster_통화" {
    label="통화"; style=rounded; color="#cccccc"; fontname="Helvetica"; fontsize=13;
    "call" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>call</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>call_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">domain</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('finance','dasan','shopping','health')</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">agent_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ended_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">channel_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">summary_confirmed_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">stt_engine</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">summary_text</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">inquiry_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR></TABLE>>];
    "transcript_segment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>transcript_segment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">segment_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">speaker</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('customer','agent')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_final</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">utterance_end_ms</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
    "masking_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>masking_event</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">segment_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">pattern</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(4)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">span_start</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">span_end</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
    "compliance_rule" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>compliance_rule</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>rule_code</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(4)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">label</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">default_severity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('high','medium','low')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">suggestion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(200)</FONT></TD></TR></TABLE>>];
    "compliance_flag" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>compliance_flag</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">segment_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">rule_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(4)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">phrase</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">confidence</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">FLOAT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">detected_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
    "call_guard_flag" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>call_guard_flag</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">segment_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('insult','threat','sexual','distress')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">phrase</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">span_start</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">span_end</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">source_doc_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">detected_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
    "voice_outlier" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>voice_outlier</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">segment_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">speaker</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('customer','agent')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">robust_z</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">FLOAT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">baseline_n</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">detected_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
  }

  subgraph "cluster_문서" {
    label="문서"; style=rounded; color="#cccccc"; fontname="Helvetica"; fontsize=13;
    "document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>document</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>document_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">doc_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('TERM','MANUAL','POLICY')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">chapter</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">clause</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">source_path</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
  }

  subgraph "cluster_추천" {
    label="추천"; style=rounded; color="#cccccc"; fontname="Helvetica"; fontsize=13;
    "recommendation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>recommendation</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>recommendation_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">trigger_at_ms</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">internal_latency_ms</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">e2e_latency_ms</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
    "recommendation_card" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>recommendation_card</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>card_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">recommendation_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">source_doc_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">summary</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">similarity_score</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">FLOAT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rank</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TINYINT</FONT></TD></TR></TABLE>>];
    "card_feedback" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>card_feedback</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">card_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('adopted','ignored')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
  }

  subgraph "cluster_종결" {
    label="종결"; style=rounded; color="#cccccc"; fontname="Helvetica"; fontsize=13;
    "closure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>closure</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>closure_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">closure_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('상품해지','보상','반품','교환')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">중도해지수수료_안내</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">약정혜택소멸_안내</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">고객확인_기록</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">사고경위_확인</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">귀책여부_확인</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">환불금액_안내</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">환불기간_안내</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">상품상태_확인</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">교환가능_확인</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">재고_확인</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">verdict</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('approved','blocked')</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">source_doc_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">decided_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
  }

  subgraph "cluster_후속처리" {
    label="후속처리"; style=rounded; color="#cccccc"; fontname="Helvetica"; fontsize=13;
    "follow_up_action" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>follow_up_action</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">action_text</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
    "knowledge_gap" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>knowledge_gap</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">module</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('B','C','F')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(300)</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">call_id_seg</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">segment_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">closure_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('open','resolved')</FONT></TD></TR></TABLE>>];
  }

  subgraph "cluster_평가" {
    label="평가"; style=rounded; color="#cccccc"; fontname="Helvetica"; fontsize=13;
    "eval_run" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>eval_run</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>run_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">golden_set_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">git_commit</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">error_rate</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">FLOAT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">executed_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">executed_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR></TABLE>>];
    "eval_result" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>eval_result</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">run_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">module</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">metric_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">metric_value</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">FLOAT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">passed_absolute_rule</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR></TABLE>>];
  }

  subgraph "cluster_G-2(조건부)" {
    label="G-2(조건부)"; style=rounded; color="#cccccc"; fontname="Helvetica"; fontsize=13;
    "resource_center" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>resource_center</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>center_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('정신건강복지센터','자살예방센터')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">operating_hours</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR></TABLE>>];
  }

  subgraph "cluster_J(콜 라우팅 보호)" {
    label="J(콜 라우팅 보호)"; style=rounded; color="#cccccc"; fontname="Helvetica"; fontsize=13;
    "blacklist_request" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>blacklist_request</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>request_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">customer_ref</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">display_hint</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(8)</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">requested_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">context_excerpt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">call_duration_s</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">insult_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">threat_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">sexual_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">temperature_outliers</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">TINYINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">ENUM('pending','approved','rejected')</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">requested_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">decided_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">decided_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">evidence_snapshot_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
    "blacklist_entry" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>blacklist_entry</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>entry_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">customer_ref</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">approved_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">released_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">released_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">release_reason</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(500)</FONT></TD></TR></TABLE>>];
    "routing_log" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2f6fed" COLSPAN="3"><FONT COLOR="white"><B>routing_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>PK</U></B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">call_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_blacklisted</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>FK</I></TD><TD ALIGN="LEFT">assigned_agent_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">fell_back</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">routed_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">DATETIME</FONT></TD></TR></TABLE>>];
  }

  "customer" -> "call" [label="  1:N (customer_id, 비식별)", style=dashed];
  "agent" -> "call" [label="  1:N (agent_id, 비식별)", style=dashed];
  "call" -> "transcript_segment" [label="  1:N (call_id, 식별)", style=solid];
  "compliance_rule" -> "compliance_flag" [label="  1:N (rule_code, 비식별)", style=dashed];
  "call" -> "recommendation" [label="  1:N (call_id, 식별)", style=solid];
  "recommendation" -> "recommendation_card" [label="  1:N (recommendation_id, 식별)", style=solid];
  "document" -> "recommendation_card" [label="  1:N (source_doc_id, 비식별)", style=dashed];
  "recommendation_card" -> "card_feedback" [label="  1:N (card_id, 식별)", style=solid];
  "call" -> "closure" [label="  1:N (call_id, 식별)", style=solid];
  "document" -> "closure" [label="  1:N (source_doc_id, 비식별)", style=dashed];
  "call" -> "follow_up_action" [label="  1:N (call_id, 식별)", style=solid];
  "call" -> "knowledge_gap" [label="  1:N (call_id, 비식별)", style=dashed];
  "closure" -> "knowledge_gap" [label="  1:N (closure_id, 비식별)", style=dashed];
  "eval_run" -> "eval_result" [label="  1:N (run_id, 식별)", style=solid];
  "document" -> "call_guard_flag" [label="  1:N (source_doc_id, 비식별)", style=dashed];
  "call" -> "blacklist_request" [label="  1:N (call_id, 식별)", style=solid];
  "agent" -> "blacklist_request" [label="  1:N (requested_by, 비식별)", style=dashed];
  "agent" -> "blacklist_request" [label="  1:N (decided_by, 비식별)", style=dashed];
  "blacklist_request" -> "blacklist_entry" [label="  1:N (request_id, 식별)", style=solid];
  "agent" -> "blacklist_entry" [label="  1:N (released_by, 비식별)", style=dashed];
  "call" -> "routing_log" [label="  1:N (call_id, 식별)", style=solid];
  "agent" -> "routing_log" [label="  1:N (assigned_agent_id, 비식별)", style=dashed];
  "legend" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#2f6fed"><FONT COLOR="white"><B>범례</B></FONT></TD></TR><TR><TD ALIGN="LEFT">━━━━━━</TD><TD ALIGN="LEFT">식별 관계 — 자식이 부모 없이는 존재 의미가 없는 약한 개체<BR/>(transcript_segment, masking_event, recommendation_card 등)</TD></TR><TR><TD ALIGN="LEFT">┄┄┄┄┄┄</TD><TD ALIGN="LEFT">비식별 관계 — 참조·분류 대상. 자식이 독립적 정체성을 가짐<BR/>(call→customer, recommendation_card→document 등)</TD></TR><TR><TD ALIGN="LEFT">──▷</TD><TD ALIGN="LEFT">까마귀발 = N쪽(자식 여러 행)</TD></TR><TR><TD ALIGN="LEFT">──┤</TD><TD ALIGN="LEFT">막대 = 1쪽(부모 1행)</TD></TR></TABLE>>, shape=plain];
}